# ====== 复制本文件为 .env 后填写 ======

# 管理密码：仅首次初始化使用（库里还没有密码哈希时用它建立）。
# 之后以库中哈希为准，改密码请在 Web 控制台「修改管理密码」里操作；
# 改这个变量不会改变密码。初始化完成后可以把它从部署环境里删掉。
# 建议至少 12 位，含字母数字符号
LOGIN_PASSWORD=change-me-to-a-strong-password

# scrypt 的 salt（首次部署固定一个，之后绝不能改，改了就再也解不开数据密钥）
# 生成： python -c "import secrets;print(secrets.token_hex(32))"
KDF_SALT=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Web session 签名密钥（任意长随机字符串；改了只会让现有登录失效）
SESSION_SECRET=change-me-to-a-long-random-session-secret

# ====== Turso（libSQL 远程数据库），留空则用本地 SQLite（DB_FILE，默认 data/key_server.db） ======
#   turso db show --url <db-name>
#   turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=change-me-to-your-turso-token

# ====== Upstash Redis KV（存解锁后的数据密钥 + 限流计数），留空则只存进程内存 ======
# 也认 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 和 Vercel KV 的 KV_REST_API_URL / KV_REST_API_TOKEN
KV_URL=https://your.upstash.io
KV_TOKEN=change-me-to-your-upstash-token

# 数据密钥在 KV 的 TTL（秒），默认 30 天；期间 Web 或 API 有访问就自动续期
MASTER_KEY_TTL=2592000
